DROP TABLE School.Scores;

ALTER TABLE School.Scores
ADD Gender CHAR(1) NULL;

UPDATE School.Scores
SET Gender = 'M'
WHERE PupilID = 4;

UPDATE School.Scores
SET Gender = 'F'
WHERE PupilID = 3;



UPDATE School.Scores
SET Gender = 'F'
WHERE PupilID = 1;


UPDATE School.Scores
SET Gender = 'F'
WHERE PupilID = 2;


